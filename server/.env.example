PORT=4000
# Neon: Dashboard → your project → Connect → copy the (pooled) connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/crewline?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
FACE_MATCH_THRESHOLD=0.5
# Business timezone: decides what "today", late arrivals and shift times mean (Vercel reserves TZ)
APP_TIMEZONE=Asia/Kolkata
# Optional: daily attendance email (Gmail: smtp.gmail.com, port 465, an app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Crewline <you@example.com>
# Optional on Vercel: CRON_SECRET (cron routes), BLOB_READ_WRITE_TOKEN (tracker screenshots + installers)
