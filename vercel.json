{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix server && npm install --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/attendance/in",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/attendance/lunch-start",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/attendance/lunch-end",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/attendance/out",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/daily-logs",
      "schedule": "0 19 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
